.npm-cache/

# Python bytecode from running the real-browser scripts
__pycache__/
*.pyc

# Local agent session data
.dsh/

# Local-only tool configs (machine-specific, never commit)
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Signing material — never commit a private key
*.pem
*.p12
*.crx
